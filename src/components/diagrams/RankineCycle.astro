---
import Figure from './Figure.astro';
import Arrow from './Arrow.astro';
---
<Figure label="แผนภาพวัฏจักร Rankine" caption="วัฏจักร Rankine: น้ำถูกปั๊มเข้าหม้อไอน้ำ กลายเป็นไอขับกังหัน แล้วควบแน่นกลับเป็นน้ำ">
  <svg viewBox="0 0 620 330" role="img" aria-label="ปั๊ม หม้อไอน้ำ กังหันไอน้ำ และคอนเดนเซอร์ ต่อกันเป็นวงจร">
    <!-- Boiler -->
    <rect x="60" y="60" width="190" height="80" rx="10" class="d-box-hot" />
    <text x="155" y="96" text-anchor="middle" class="d-label">หม้อไอน้ำ</text>
    <text x="155" y="117" text-anchor="middle" class="d-note">Boiler</text>
    <Arrow pts={[[155, 12], [155, 58]]} kind="hot" />
    <text x="167" y="30" class="d-text d-t-hot">Q<tspan dy="4" font-size="10">in</tspan></text>

    <!-- Turbine -->
    <path d="M400 70 L520 45 L520 155 L400 130 Z" class="d-box-accent" />
    <text x="462" y="97" text-anchor="middle" class="d-label">กังหันไอน้ำ</text>
    <text x="462" y="117" text-anchor="middle" class="d-note">Turbine</text>
    <Arrow pts={[[520, 100], [590, 100]]} kind="power" />
    <text x="556" y="88" text-anchor="middle" class="d-text d-t-power">W<tspan dy="4" font-size="10">out</tspan></text>

    <!-- Condenser -->
    <rect x="390" y="225" width="150" height="70" rx="10" class="d-box-water" />
    <text x="465" y="256" text-anchor="middle" class="d-label">คอนเดนเซอร์</text>
    <text x="465" y="276" text-anchor="middle" class="d-note">Condenser</text>
    <Arrow pts={[[540, 260], [600, 260]]} kind="water" />
    <text x="572" y="248" text-anchor="middle" class="d-text d-t-water">Q<tspan dy="4" font-size="10">out</tspan></text>

    <!-- Pump -->
    <circle cx="155" cy="260" r="34" class="d-box" />
    <text x="155" y="257" text-anchor="middle" class="d-label">ปั๊ม</text>
    <text x="155" y="275" text-anchor="middle" class="d-note">Pump</text>
    <Arrow pts={[[60, 260], [119, 260]]} kind="power" />
    <text x="86" y="248" text-anchor="middle" class="d-text d-t-power">W<tspan dy="4" font-size="10">pump</tspan></text>

    <!-- Flows -->
    <Arrow pts={[[250, 100], [398, 100]]} kind="steam" />
    <text x="324" y="90" text-anchor="middle" class="d-small">ไอดง แรงดันสูง</text>
    <Arrow pts={[[480, 152], [480, 223]]} kind="steam" dashed />
    <text x="490" y="192" class="d-small">ไอเปียก แรงดันต่ำ</text>
    <Arrow pts={[[390, 260], [191, 260]]} kind="water" />
    <text x="290" y="250" text-anchor="middle" class="d-small">น้ำ แรงดันต่ำ</text>
    <Arrow pts={[[155, 226], [155, 142]]} kind="water" />
    <text x="165" y="188" class="d-small">น้ำ แรงดันสูง</text>

    <!-- State points -->
    {[[155, 210, '1'], [270, 100, '2'], [480, 168, '3'], [370, 260, '4']].map(([x, y, n]) => (
      <g><circle cx={x} cy={y} r="10" class="d-box" /><text x={x} y={Number(y) + 4} text-anchor="middle" class="d-small" font-weight="700">{n}</text></g>
    ))}
  </svg>
</Figure>
