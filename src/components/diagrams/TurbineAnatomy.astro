---
import Figure from './Figure.astro';
import Arrow from './Arrow.astro';
const labels: { th: string; en: string; tx: number; ty: number }[] = [
  { th: 'ใบพัด', en: 'Blade', tx: 150, ty: 62 },
  { th: 'Hub + ระบบ pitch', en: 'ปรับมุมใบพัด', tx: 96, ty: 151 },
  { th: 'Main bearing', en: 'แบริ่งหลัก', tx: 188, ty: 116 },
  { th: 'Gearbox', en: 'กล่องเกียร์', tx: 245, ty: 108 },
  { th: 'Generator', en: 'เครื่องกำเนิดไฟฟ้า', tx: 319, ty: 112 },
  { th: 'Converter', en: 'แปลงความถี่และแรงดัน', tx: 378, ty: 116 },
  { th: 'Yaw system', en: 'หมุน nacelle ตามทิศลม', tx: 230, ty: 206 },
  { th: 'Tower + Foundation', en: 'เสาและฐานราก', tx: 300, ty: 300 },
  { th: 'หม้อแปลง', en: 'เพิ่มแรงดันเข้าสายในฟาร์ม', tx: 338, ty: 352 },
];
---
<Figure label="ส่วนประกอบของกังหันลม" caption="ส่วนประกอบหลักของกังหันลมแกนนอนแบบมีเกียร์ (มุมมองด้านข้าง)">
  <svg viewBox="0 0 700 440" role="img" aria-label="ใบพัด hub nacelle ที่มี main bearing gearbox generator converter, yaw system, เสา, ฐานราก และหม้อแปลง">
    <!-- ground & foundation -->
    <line x1="20" y1="400" x2="440" y2="400" class="d-ground" />
    <rect x="215" y="400" width="100" height="22" rx="3" class="d-box" />
    <!-- tower -->
    <path d="M255 192 L275 192 L284 400 L246 400 Z" class="d-box" />
    <!-- transformer + cable -->
    <rect x="320" y="370" width="36" height="30" rx="4" class="d-box-power" />
    <text x="338" y="390" text-anchor="middle" class="d-small">TR</text>
    <Arrow pts={[[356, 392], [440, 392]]} kind="power" />
    <text x="398" y="383" text-anchor="middle" class="d-small">33 kV</text>
    <!-- nacelle -->
    <rect x="150" y="112" width="260" height="78" rx="14" class="d-box" />
    <rect x="245" y="190" width="40" height="8" rx="2" class="d-box-accent" />
    <!-- drivetrain -->
    <line x1="150" y1="151" x2="300" y2="151" class="d-shaft" />
    <rect x="176" y="136" width="24" height="30" rx="3" class="d-box-accent" />
    <rect x="215" y="124" width="60" height="54" rx="6" class="d-box-accent" />
    <rect x="290" y="128" width="58" height="46" rx="6" class="d-box-power" />
    <rect x="358" y="132" width="40" height="38" rx="5" class="d-box" />
    <path d="M398 151 L405 151 L405 196 L272 196" class="d-flow d-power" style="stroke-width:1.6" />
    <path d="M272 198 L272 370 L320 380" class="d-flow d-power" style="stroke-width:1.6" />
    <!-- hub & blades -->
    <path d="M150 128 Q112 132 104 151 Q112 170 150 174 Z" class="d-box-accent" />
    <path d="M128 140 Q118 80 132 18 Q142 16 146 26 Q150 90 140 142 Z" class="d-box" />
    <path d="M128 162 Q118 222 120 300 Q130 304 136 296 Q148 220 140 160 Z" class="d-box" />
    <circle cx="132" cy="151" r="7" class="d-box-accent" />
    <!-- numbered callouts -->
    {labels.map((l, i) => (
      <g>
        <circle cx={l.tx} cy={l.ty} r="10" class="d-fill-accent" />
        <text x={l.tx} y={l.ty + 4} text-anchor="middle" font-size="11" font-weight="700" fill="#fff">{i + 1}</text>
      </g>
    ))}
    <!-- key -->
    {labels.map((l, i) => (
      <g>
        <circle cx="478" cy={46 + i * 42} r="10" class="d-fill-accent" />
        <text x="478" y={50 + i * 42} text-anchor="middle" font-size="11" font-weight="700" fill="#fff">{i + 1}</text>
        <text x="496" y={46 + i * 42} class="d-text" font-weight="600">{l.th}</text>
        <text x="496" y={61 + i * 42} class="d-small">{l.en}</text>
      </g>
    ))}
    <text x="160" y="200" class="d-note">Nacelle</text>
    <text x="70" y="420" class="d-small">ลม →</text>
  </svg>
</Figure>
