---
// Polyline with an arrowhead at the last point. `kind` picks the flow colour.
interface Props {
  pts: [number, number][];
  kind?: 'line' | 'hot' | 'water' | 'steam' | 'power' | 'sun' | 'accent';
  size?: number;
  dashed?: boolean;
  head?: boolean;
}
const { pts, kind = 'line', size = 9, dashed = false, head = true } = Astro.props;
const [x2, y2] = pts[pts.length - 1];
const [x1, y1] = pts[pts.length - 2];
const len = Math.hypot(x2 - x1, y2 - y1) || 1;
const ux = (x2 - x1) / len, uy = (y2 - y1) / len;
const bx = x2 - ux * size, by = y2 - uy * size;
const px = -uy * size * 0.55, py = ux * size * 0.55;
const linePts = head ? [...pts.slice(0, -1), [bx, by]] : pts;
const d = linePts.map(([x, y], i) => `${i ? 'L' : 'M'}${x.toFixed(1)} ${y.toFixed(1)}`).join(' ');
const tri = `${x2},${y2} ${(bx + px).toFixed(1)},${(by + py).toFixed(1)} ${(bx - px).toFixed(1)},${(by - py).toFixed(1)}`;
---
<path d={d} class:list={['d-flow', `d-${kind}`, { 'd-dashed': dashed }]} />
{head && <polygon points={tri} class:list={['d-head', `d-fill-${kind}`]} />}
