---
interface Props { icon: string; color: string; size?: string }
const { icon, color, size = '3rem' } = Astro.props;
---
<span class="course-icon" style={`--c:${color};--s:${size}`} aria-hidden="true"
  set:html={`<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">${icon}</svg>`} />
<style>
  .course-icon {
    flex: none; width: var(--s); height: var(--s); border-radius: 0.8rem; display: grid; place-items: center;
    color: var(--c); background: color-mix(in srgb, var(--c) 14%, transparent);
  }
  .course-icon :global(svg) { width: 58%; height: 58%; }
</style>
