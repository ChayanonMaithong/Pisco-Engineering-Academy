---
// Certificate of completion. Hidden until the course is completed (all lessons + exam passed).
interface Props { courseId: string; title: string; lessons: string[] }
const { courseId, title, lessons } = Astro.props;
---
<section class="certificate" data-course={courseId} data-lessons={JSON.stringify(lessons)} hidden>
  <div class="cert-paper">
    <div class="cert-brand">Pisco Engineering Academy</div>
    <div class="cert-kicker">ประกาศนียบัตรการเรียนจบคอร์ส</div>
    <div class="cert-intro">ขอมอบให้แก่</div>
    <div class="cert-name" data-cert-name>ผู้เรียน</div>
    <div class="cert-intro">ได้เรียนครบทุกบทเรียน และผ่านแบบทดสอบท้ายคอร์ส</div>
    <div class="cert-course">{title}</div>
    <div class="cert-meta"><span data-cert-score></span><span data-cert-date></span></div>
    <div class="cert-note">ประกาศนียบัตรสำหรับการเรียนรู้ด้วยตนเอง ไม่ใช่วุฒิการศึกษาหรือใบรับรองวิชาชีพ</div>
  </div>
  <div class="cert-actions">
    <label>ชื่อที่จะแสดงบนประกาศนียบัตร
      <input type="text" maxlength="80" placeholder="พิมพ์ชื่อ-นามสกุล" data-cert-input />
    </label>
    <button type="button" data-cert-print>พิมพ์ / บันทึกเป็น PDF</button>
  </div>
</section>

<script>
  import { load, setName } from '../../scripts/progress';
  function render() {
    const p = load();
    document.querySelectorAll<HTMLElement>('.certificate').forEach((el) => {
      const rec = p.exams[el.dataset.course!];
      const lessons: string[] = JSON.parse(el.dataset.lessons!);
      const complete = rec?.passed && lessons.every((l) => p.lessons[l]);
      el.hidden = !complete;
      if (!complete) return;
      el.querySelector('[data-cert-name]')!.textContent = p.name || 'ผู้เรียน';
      el.querySelector('[data-cert-score]')!.textContent = `คะแนน ${rec.score}/${rec.total} (${rec.percent}%)`;
      el.querySelector('[data-cert-date]')!.textContent =
        'วันที่ ' + new Date(rec.date).toLocaleDateString('th-TH', { year: 'numeric', month: 'long', day: 'numeric' });
      const input = el.querySelector<HTMLInputElement>('[data-cert-input]')!;
      if (document.activeElement !== input) input.value = p.name;
    });
  }
  document.addEventListener('input', (e) => {
    const t = e.target as HTMLElement;
    if (t.matches('[data-cert-input]')) { setName((t as HTMLInputElement).value.trim()); render(); }
  });
  document.addEventListener('click', (e) => {
    const btn = (e.target as HTMLElement).closest('[data-cert-print]');
    if (!btn) return;
    const cert = btn.closest('.certificate')!;
    cert.classList.add('printing');
    document.body.classList.add('printing-cert');
    window.print();
  });
  window.addEventListener('afterprint', () => {
    document.body.classList.remove('printing-cert');
    document.querySelectorAll('.certificate.printing').forEach((c) => c.classList.remove('printing'));
  });
  window.addEventListener('progress-changed', render);
  render();
</script>

<style>
  .certificate { margin-top: 2rem; }
  .cert-paper {
    position: relative; text-align: center; padding: 2.5rem 1.5rem 2rem; border-radius: var(--radius-l);
    background: var(--surface); border: 2px solid color-mix(in srgb, var(--level-2) 55%, transparent);
    box-shadow: var(--shadow), inset 0 0 0 6px var(--surface), inset 0 0 0 7px color-mix(in srgb, var(--level-2) 30%, transparent);
  }
  .cert-brand { font-family: var(--font-heading); font-weight: 700; color: var(--sl-color-text-accent); letter-spacing: 0.02em; }
  .cert-kicker { margin-top: 0.4rem; font-size: 0.9rem; color: var(--sl-color-gray-3); }
  .cert-intro { margin-top: 1.2rem; color: var(--sl-color-gray-3); font-size: 0.95rem; }
  .cert-name { margin-top: 0.3rem; font-family: var(--font-heading); font-size: 1.9rem; font-weight: 700; color: var(--sl-color-white); }
  .cert-course { margin-top: 0.4rem; font-family: var(--font-heading); font-size: 1.4rem; font-weight: 600; color: var(--sl-color-text-accent); }
  .cert-meta { display: flex; justify-content: center; gap: 1.5rem; flex-wrap: wrap; margin-top: 1.2rem; font-size: 0.9rem; color: var(--sl-color-gray-2); }
  .cert-note { margin-top: 1.2rem; font-size: 0.75rem; color: var(--sl-color-gray-4); }
  .cert-actions { display: flex; flex-wrap: wrap; gap: 0.75rem; align-items: flex-end; justify-content: space-between; margin-top: 1rem; }
  .cert-actions label { display: flex; flex-direction: column; gap: 0.3rem; font-size: 0.85rem; color: var(--sl-color-gray-3); flex: 1; min-width: 14rem; }
  .cert-actions input {
    font: inherit; padding: 0.55rem 0.75rem; border-radius: var(--radius-s); color: var(--sl-color-white);
    background: var(--sl-color-black); border: 1px solid var(--sl-color-gray-5);
  }
  .cert-actions button {
    font: inherit; font-weight: 600; padding: 0.6rem 1.1rem; border-radius: 999px; cursor: pointer;
    color: var(--sl-color-text-accent); background: transparent; border: 1px solid var(--sl-color-accent);
  }
</style>
