---
// P = ½ ρ A v³ Cp
---
<div class="calc not-content" data-calc="wind">
  <strong>🧮 กำลังของกังหันลม</strong>
  <label>เส้นผ่านศูนย์กลางใบพัด, D (m)
    <input type="number" name="d" value="150" min="1" />
  </label>
  <label>ความเร็วลม, v (m/s)
    <input type="number" name="v" value="8" step="0.5" min="0" />
  </label>
  <label>สัมประสิทธิ์กำลัง, Cp (สูงสุดตามทฤษฎี 0.593)
    <input type="number" name="cp" value="0.45" step="0.01" min="0" max="0.593" />
  </label>
  <label>ความหนาแน่นอากาศ, ρ (kg/m³)
    <input type="number" name="rho" value="1.225" step="0.005" min="0" />
  </label>
  <output></output>
</div>
<script>
  document.querySelectorAll<HTMLElement>('[data-calc="wind"]').forEach((el) => {
    const get = (n: string) => Number(el.querySelector<HTMLInputElement>(`input[name="${n}"]`)!.value);
    const out = el.querySelector('output')!;
    const update = () => {
      const area = Math.PI * (get('d') / 2) ** 2;
      const pw = 0.5 * get('rho') * area * get('v') ** 3 * get('cp');
      out.textContent = `P ≈ ${(pw / 1e6).toFixed(2)} MW (พื้นที่กวาด ${Math.round(area).toLocaleString('en-US')} m²) — ยังไม่จำกัดด้วย rated power ของเครื่อง`;
    };
    el.querySelectorAll('input').forEach((i) => i.addEventListener('input', update));
    update();
  });
</script>
