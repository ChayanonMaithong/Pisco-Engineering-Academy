---
// เครื่องคำนวณแรงดันไฮโดรสแตติกของน้ำโคลน: P (psi) = 0.052 × MW (ppg) × TVD (ft)
---
<div class="calc not-content" data-calc="hydrostatic">
  <strong>🧮 คำนวณแรงดันไฮโดรสแตติก</strong>
  <label>น้ำหนักน้ำโคลน, MW (ppg)
    <input type="number" name="mw" value="10" step="0.1" min="0" />
  </label>
  <label>ความลึกแนวดิ่งจริง, TVD (ft)
    <input type="number" name="tvd" value="10000" step="100" min="0" />
  </label>
  <output></output>
</div>
<script>
  document.querySelectorAll<HTMLElement>('[data-calc="hydrostatic"]').forEach((el) => {
    const mw = el.querySelector<HTMLInputElement>('input[name="mw"]')!;
    const tvd = el.querySelector<HTMLInputElement>('input[name="tvd"]')!;
    const out = el.querySelector('output')!;
    const update = () => {
      const psi = 0.052 * Number(mw.value) * Number(tvd.value);
      const grad = 0.052 * Number(mw.value);
      out.textContent = `P ≈ ${psi.toLocaleString('en-US', { maximumFractionDigits: 0 })} psi (${(psi * 0.0068948).toFixed(1)} MPa) · gradient ${grad.toFixed(3)} psi/ft`;
    };
    mw.addEventListener('input', update);
    tvd.addEventListener('input', update);
    update();
  });
</script>
